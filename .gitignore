# Saved copies of live pages — ground truth for template work, but 16MB.
# Re-save from dubizzle.com.eg if you need them; see HANDOFF.md.
design-kit/reference/live/

# skill-creator optimization scratch (logs, iteration runs)
.claude/skills/*-workspace/

# Transient skill-eval artifacts
.claude/skills/token-check-workspace/

# throwaway measurement scripts
scripts/.tmp-*

# Account templates (my-ads, chat, edit-profile, settings, packages, favourites, saved-searches,
# post-ad, upsell, user-menu, m-user-menu) ARE tracked since 2026-10-06 (owner's request, private repo),
# like the portal templates below. They come from redacted logged-in captures: run
# `npm run check:prototype` (PII scan) and look at every people screen before committing a rebuild.
design-kit/templates/_live/fidelity.json

# Design-tool exports — large, contain licensed fonts and raw screenshots.
# What matters from them is extracted into tokens/illustrations and committed;
# the raw bundle stays local like the captures. See docs/DECISIONS.md D-013.
design-kit/reference/exports/
# Agency portal templates (desktop only, D-012) ARE tracked since 2026-09-30 (owner's request, private repo).
# They come from signed-in captures whose people-rows are fixtured before anything is written (D-011);
# every build is PII-scanned before it is committed. Do not re-add `portal-*.html` here without asking.
# Signed-in consumer modal states (dpv-report-in, dpv-report-form) are tracked too since 2026-10-06, same gate.
design-kit/reference/live/screens/_live-check/

# Remotion skills installed via `npx skills add` — kept local, not part of the
# design-system repo. Remove this block (and commit .agents/) if you decide to
# keep them; or `rm -rf .agents skills-lock.json .claude/skills/remotion-*` to drop them.
.agents/
skills-lock.json
.claude/skills/remotion-*

# design-qa run output (regenerate with the design-qa skill)
design-kit/qa/report/
# design-deliverables build output
design-kit/deliverables/*/dist/

__pycache__/
*.pyc

# icons skill: cached @iconify-json packages and candidate lists
icons/.npm-sets/
icons/candidates.json

# partial extractor runs (--paths / --layout) are scratch
design-kit/analytics/live/*.partial.json
