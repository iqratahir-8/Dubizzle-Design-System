{
  "name": "dubizzle-design-system",
  "version": "0.1.0",
  "description": "React component library and design tokens for dubizzle Egypt — buttons, forms, ad cards, header/footer, and the foundations behind them.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./tokens/*": "./src/tokens/*",
    "./assets/*": "./src/assets/*"
  },
  "files": [
    "dist",
    "src/tokens",
    "src/assets"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "kit": "python3 -m http.server 4321 --directory design-kit",
    "build": "tsup",
    "build:storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "sync": "npm run sync:tokens && npm run sync:icons && npm run build:icons && npm run build:templates && npm run build:preview",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "sync:icons": "node scripts/sync-icons.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:all": "node scripts/check-design.mjs design-kit/*.html design-kit/patterns/*.css design-kit/templates/*.html design-kit/templates/*/*.html src/components/*/*.module.css src/templates/*.module.css",
    "build:templates": "node scripts/build-templates.mjs && node scripts/build-live-templates.mjs && node scripts/wire-prototype.mjs && node scripts/build-flows.mjs && node scripts/build-template-stories.mjs",
    "wire:prototype": "node scripts/wire-prototype.mjs && node scripts/build-flows.mjs",
    "build:flows": "node scripts/build-flows.mjs",
    "check:flows": "node scripts/check-flows.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "capture:live": "node scripts/capture-live.mjs",
    "capture:rendered": "node scripts/capture-rendered.mjs",
    "capture:login": "node scripts/capture-session.mjs",
    "capture:account": "node scripts/capture-account.mjs",
    "build:gallery": "node scripts/build-screens-gallery.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:captures": "node scripts/check-captures.mjs",
    "build:icons": "node scripts/build-component-icons.mjs",
    "check:templates": "node scripts/check-captures.mjs --templates",
    "capture:post-ad": "node scripts/capture-post-ad.mjs",
    "capture:chat-thread": "node scripts/capture-chat-thread.mjs",
    "capture:states": "node scripts/capture-states.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:prototype": "node scripts/check-prototype.mjs",
    "extract:portal-filters": "node scripts/extract-portal-filters.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "qa:registry": "python3 .claude/skills/design-qa/scripts/build_registry.py",
    "qa:matrix": "python3 .claude/skills/design-qa/scripts/matrix.py",
    "qa": "python3 .claude/skills/design-qa/scripts/run.py",
    "deliverable": "python3 .claude/skills/design-deliverables/scripts/build_deliverable.py",
    "package:skill": "python3 scripts/package-single-skill.py",
    "localize:assets": "node scripts/localize-remote-assets.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "puppeteer-core": "^25.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.7",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "keywords": [
    "design-system",
    "react",
    "dubizzle",
    "component-library",
    "ui-kit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iqratahir/dubizzle-design-system.git"
  }
}
