      "ga4_recommended": true,
      "key_event_default": false,
      "purpose": "A list of listings is shown: LPV, favourites, similar ads.",
      "fires_on": "first render of the list, and again when filters or sort change",
      "page_types": [
        "lpv",
        "favourites",
        "dpv"
      ],
      "parameters": {
        "item_list_id": {
          "type": "string",
          "example": "lpv",
