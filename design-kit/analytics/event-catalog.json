{
  "_purpose": "The one list of analytics events for every dubizzle tenant. Edited only through the event-taxonomy skill. Every event here is a PROPOSAL until it is observed on live (`npm run extract:tracking`) or confirmed by the analytics owner.",
  "version": "0.1.0",
  "naming": {
    "pattern": "^[a-z][a-z0-9_]{0,39}$",
    "style": "verb_object, GA4 recommended name when one fits",
    "reserved_prefixes": [
      "ga_",
      "google_",
      "firebase_"
    ],
    "reserved_names": [
      "ad_activeview",
      "ad_click",
      "ad_exposure",
      "ad_query",
      "ad_reward",
      "adunit_exposure",
      "app_background",
      "app_clear_data",
      "app_exception",
      "app_install",
      "app_remove",
      "app_store_refund",
      "app_update",
      "app_upgrade",
      "dynamic_link_app_open",
      "dynamic_link_app_update",
      "dynamic_link_first_open",
      "error",
      "first_open",
      "first_visit",
      "in_app_purchase",
      "notification_dismiss",
      "notification_foreground",
      "notification_open",
      "notification_receive",
      "os_update",
      "screen_view",
      "session_start",
      "user_engagement"
    ],
    "limits": {
      "name_chars": 40,
      "param_name_chars": 40,
      "param_value_chars": 100,
      "params_per_event": 25
    },
    "limits_source": "GA4 collection limits for standard properties as documented by Google; re-check the GA4 help centre before a release — limits change.",
    "pii_param_pattern": "^((user|seller|buyer|contact|customer|account)_)?(name|first_name|last_name|full_name|dob|birth_date|address|message|message_text)$|(email|phone|mobile_number|msisdn|whatsapp_number|national_id)"
  },
  "status_values": [
    "proposed",
    "approved",
    "live",
    "deprecated"
  ],
  "events": [
    {
      "name": "search",
      "status": "proposed",
      "ga4_recommended": true,
      "key_event_default": false,
      "purpose": "A search is submitted (keyboard, suggestion or hero search).",
      "fires_on": "the results request is sent",
      "page_types": [
        "home",
        "lpv"
      ],
      "parameters": {
        "search_term": {
          "type": "string",
          "example": "toyota corolla",
          "required": true,
          "note": "strip phone numbers before sending"
        },
        "category_id": {
          "type": "string",
          "example": "23",
          "required": false
        },
        "filters_applied": {
          "type": "number",
          "example": 2,
          "required": false
        },
        "results_count": {
          "type": "number",
          "example": 148,
          "required": false
        }
      },
      "observed_live": {}
    },
    {
